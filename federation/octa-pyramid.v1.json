  "semantics": {
    "complete_pairwise_product": true,
    "directed_link_count_formula": "n*(n-1)",
    "hub_is_not_a_runtime_gateway": true,
    "request_response_edges_are_synchronous": true,
    "no_implicit_native_loading": true,
    "no_driver_mutation_through_mesh": true
  }
