{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ivan-vhs.dev/supabase-adapter.v1.schema.json",
  "title": "Ivan-VHS Supabase Adapter Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "repository",
    "role",
    "status",
    "default_mode",
    "supabase",
    "network_policy",
    "local_first",
    "contracts",
    "data_domains",
    "excluded_data",
    "security"
  ],
  "properties": {
    "schema": {
      "const": "ivan-vhs.supabase-adapter.v1"
    },
    "project": {
      "enum": [
        "duckos",
        "reaper",
        "pytyliki",
        "ventusample",
        "oplague"
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^Ivan-VHS/(DuckOS|Reaper|Pytyliki|VentuSample|OPlague)$"
    },
    "role": {
      "enum": [
        "control-plane",
        "producer",
        "consumer",
        "producer-consumer"
      ]
    },
    "status": {
      "enum": [
        "contract-only",
        "local-ci-verified",
        "hosted-verified"
      ]
    },
    "default_mode": {
      "const": "offline-only"
    },
    "supabase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment",
        "url_env",
        "publishable_key_env",
        "service_role_key_in_client"
      ],
      "properties": {
        "deployment": {
          "enum": [
            "not-configured",
            "local-ci-only",
            "hosted"
          ]
        },
        "url_env": {
          "const": "SUPABASE_URL"
        },
        "publishable_key_env": {
          "const": "SUPABASE_PUBLISHABLE_KEY"
        },
        "service_role_key_in_client": {
          "const": false
        }
      }
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled_by_default",
        "background_sync",
        "requires_user_action"
      ],
      "properties": {
        "enabled_by_default": {
          "const": false
        },
        "background_sync": {
          "const": false
        },
        "requires_user_action": {
          "const": true
        }
      }
    },
    "local_first": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_data_authoritative",
        "sync_model",
        "conflict_resolution"
      ],
      "properties": {
        "local_data_authoritative": {
          "const": true
        },
        "sync_model": {
          "const": "append-only-event-log"
        },
        "conflict_resolution": {
          "const": "domain-specific-versioned"
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_envelope",
        "artifact_manifest"
      ],
      "properties": {
        "event_envelope": {
          "const": "ivan-vhs.ecosystem-event.v1"
        },
        "artifact_manifest": {
          "const": "ivan-vhs.ecosystem-artifact.v1"
        }
      }
    },
    "data_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excluded_data": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rls_required",
        "service_role_key_never_in_client",
        "explicit_upload_consent",
        "telemetry_default"
      ],
      "properties": {
        "rls_required": {
          "const": true
        },
        "service_role_key_never_in_client": {
          "const": true
        },
        "explicit_upload_consent": {
          "const": true
        },
        "telemetry_default": {
          "const": "disabled"
        }
      }
    }
  }
}
