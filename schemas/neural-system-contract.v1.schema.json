{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/DAK/blob/main/schemas/neural-system-contract.v1.schema.json",
  "title": "Ivan-VHS Neural System Contract v1",
  "description": "Validates the shared 20-profile catalogue and repository-specific neural system contracts.",
  "oneOf": [
    {
      "$ref": "#/$defs/catalog"
    },
    {
      "$ref": "#/$defs/contract"
    }
  ],
  "$defs": {
    "profile": {
      "type": "object",
      "required": [
        "id",
        "system_type",
        "neural_contract",
        "engineering_domain"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^nscf-(0[1-9]|1[0-9]|20)$"
        },
        "system_type": {
          "type": "string",
          "minLength": 1
        },
        "neural_contract": {
          "type": "string",
          "minLength": 1
        },
        "engineering_domain": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "profile_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^nscf-(0[1-9]|1[0-9]|20)$"
      }
    },
    "catalog": {
      "type": "object",
      "required": [
        "schema",
        "version",
        "owner",
        "description",
        "profiles"
      ],
      "properties": {
        "schema": {
          "const": "ivan-vhs.neural-system-catalog.v1"
        },
        "version": {
          "const": 1
        },
        "owner": {
          "const": "Ivan-VHS/DAK"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "$ref": "#/$defs/profiles"
        }
      },
      "additionalProperties": false
    },
    "proposed_interface": {
      "type": "object",
      "required": [
        "id",
        "direction",
        "status",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]+\\.v1$"
        },
        "direction": {
          "enum": [
            "provides",
            "consumes"
          ]
        },
        "status": {
          "const": "planned"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": [
        "schema",
        "version",
        "repository",
        "catalog",
        "adoption",
        "integration",
        "runtime",
        "io_contract",
        "governance",
        "quality_gates",
        "status"
      ],
      "properties": {
        "schema": {
          "const": "ivan-vhs.neural-system-contract.v1"
        },
        "version": {
          "const": 1
        },
        "repository": {
          "type": "object",
          "required": [
            "full_name",
            "project_id",
            "role",
            "domain",
            "implementation_track"
          ],
          "properties": {
            "full_name": {
              "type": "string",
              "pattern": "^Ivan-VHS/[A-Za-z0-9._-]+$"
            },
            "project_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "implementation_track": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "catalog": {
          "type": "object",
          "required": [
            "source_repository",
            "source_path",
            "version",
            "profile_count",
            "local_snapshot"
          ],
          "properties": {
            "source_repository": {
              "const": "Ivan-VHS/DAK"
            },
            "source_path": {
              "const": "neural-system-catalog.v1.json"
            },
            "version": {
              "const": 1
            },
            "profile_count": {
              "const": 20
            },
            "local_snapshot": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "adoption": {
          "type": "object",
          "required": [
            "mode",
            "planned_primary_profile_ids",
            "planned_supporting_profile_ids",
            "all_profiles_available"
          ],
          "properties": {
            "mode": {
              "const": "planned"
            },
            "planned_primary_profile_ids": {
              "$ref": "#/$defs/profile_ids",
              "minItems": 1
            },
            "planned_supporting_profile_ids": {
              "$ref": "#/$defs/profile_ids"
            },
            "all_profiles_available": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "integration": {
          "type": "object",
          "required": [
            "responsibilities",
            "non_goals",
            "proposed_interfaces"
          ],
          "properties": {
            "responsibilities": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "non_goals": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "proposed_interfaces": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/proposed_interface"
              }
            }
          },
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "required": [
            "state",
            "engine",
            "execution",
            "training",
            "inference",
            "external_data_transfer",
            "telemetry",
            "resource_policy"
          ],
          "properties": {
            "state": {
              "const": "not_implemented"
            },
            "engine": {
              "const": "none"
            },
            "execution": {
              "const": "disabled"
            },
            "training": {
              "const": "disabled"
            },
            "inference": {
              "const": "disabled"
            },
            "external_data_transfer": {
              "const": "deny_by_default"
            },
            "telemetry": {
              "const": "disabled"
            },
            "resource_policy": {
              "const": "explicit_budgets_required_before_execution"
            }
          },
          "additionalProperties": false
        },
        "io_contract": {
          "type": "object",
          "required": [
            "input_required_fields",
            "output_required_fields",
            "failure_codes",
            "semantic_guarantees"
          ],
          "properties": {
            "input_required_fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "output_required_fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "failure_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "semantic_guarantees": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "governance": {
          "type": "object",
          "required": [
            "human_review_required",
            "training_requires_explicit_approval",
            "external_data_export",
            "telemetry",
            "secret_access",
            "autonomous_main_branch_writes",
            "rollback_plan_required"
          ],
          "properties": {
            "human_review_required": {
              "const": true
            },
            "training_requires_explicit_approval": {
              "const": true
            },
            "external_data_export": {
              "const": false
            },
            "telemetry": {
              "const": "disabled"
            },
            "secret_access": {
              "const": "denied"
            },
            "autonomous_main_branch_writes": {
              "const": false
            },
            "rollback_plan_required": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "quality_gates": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "object",
          "required": [
            "architecture",
            "implementation",
            "validation"
          ],
          "properties": {
            "architecture": {
              "const": "specified"
            },
            "implementation": {
              "const": "not_implemented"
            },
            "validation": {
              "const": "not_run"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
