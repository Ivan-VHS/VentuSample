{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivan-vhs.github.io/beelzebul/appguard.v1.schema.json",
  "title": "Beelzebul AppGuard 666 Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_status",
    "implementation_claims",
    "repository_profile",
    "echelons",
    "levels",
    "repository_rule_groups",
    "verdict_contract",
    "runtime_enforcement"
  ],
  "properties": {
    "schema_version": {
      "const": "beelzebul.appguard/v1"
    },
    "catalog_status": {
      "const": "policy_catalog_only"
    },
    "implementation_claims": {
      "type": "integer",
      "minimum": 0
    },
    "repository_profile": {
      "type": "object",
      "required": [
        "project",
        "runtime",
        "surfaces",
        "guardrails"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "guardrails": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "echelons": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "start",
          "end",
          "purpose",
          "domains"
        ],
        "properties": {
          "id": {
            "enum": [
              "I",
              "II",
              "III",
              "IV",
              "V",
              "VI"
            ]
          },
          "name": {
            "type": "string"
          },
          "start": {
            "type": "integer"
          },
          "end": {
            "type": "integer"
          },
          "purpose": {
            "type": "string"
          },
          "domains": {
            "type": "array",
            "minItems": 11,
            "maxItems": 11,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 666,
      "maxItems": 666,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level_id",
          "number",
          "echelon_id",
          "subsystem",
          "control_id",
          "control_title",
          "objective",
          "implementation_state",
          "enforcement",
          "source_refs",
          "test_refs",
          "verification_refs"
        ],
        "properties": {
          "level_id": {
            "type": "string",
            "pattern": "^L[0-9]{3}$"
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 666
          },
          "echelon_id": {
            "enum": [
              "I",
              "II",
              "III",
              "IV",
              "V",
              "VI"
            ]
          },
          "subsystem": {
            "type": "string",
            "minLength": 1
          },
          "control_id": {
            "type": "string",
            "minLength": 1
          },
          "control_title": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "implementation_state": {
            "enum": [
              "planned",
              "specified",
              "partial",
              "implemented",
              "verified",
              "deferred",
              "not_applicable"
            ]
          },
          "enforcement": {
            "enum": [
              "not_enforced",
              "partially_enforced",
              "enforced"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "repository_rule_groups": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "prefix",
          "count",
          "rule_ids",
          "scope",
          "candidate_echelons",
          "per_rule_mapping_status"
        ],
        "properties": {
          "prefix": {
            "enum": [
              "A",
              "M",
              "Y",
              "K",
              "O"
            ]
          },
          "count": {
            "type": "integer"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "type": "string"
          },
          "candidate_echelons": {
            "type": "array",
            "items": {
              "enum": [
                "I",
                "II",
                "III",
                "IV",
                "V",
                "VI"
              ]
            }
          },
          "per_rule_mapping_status": {
            "const": "pending_full_rule_text"
          }
        }
      }
    },
    "verdict_contract": {
      "type": "object",
      "required": [
        "allowed_verdicts",
        "required_event_fields",
        "override_requirements"
      ],
      "properties": {
        "allowed_verdicts": {
          "const": [
            "allow",
            "quarantine",
            "deny",
            "degrade"
          ]
        },
        "required_event_fields": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string"
          }
        },
        "override_requirements": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "runtime_enforcement": {
      "const": "not_implemented_by_catalog"
    }
  }
}
