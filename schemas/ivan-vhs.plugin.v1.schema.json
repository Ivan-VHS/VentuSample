{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivan-vhs.github.io/plugin-contract/ivan-vhs.plugin.v1.schema.json",
  "title": "Ivan-VHS Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "api_version", "host", "domain", "description", "capabilities", "entrypoint"],
  "properties": {
    "schema": { "const": "ivan-vhs.plugin.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "api_version": { "const": 1 },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "enum": ["reaper", "ventu"] },
        "min_version": { "type": "string" }
      }
    },
    "domain": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$", "maxLength": 80 }
    },
    "entrypoint": { "type": "string", "minLength": 1, "maxLength": 240 }
  }
}
