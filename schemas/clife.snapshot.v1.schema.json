{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/contracts/clife.snapshot.v1.schema.json",
  "title": "CLife Snapshot Manifest v1",
  "type": "object",
  "required": [
    "schema",
    "created_at",
    "root_name",
    "file_count",
    "total_bytes",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "clife.snapshot.v1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "root_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "file_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20000
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1073741824
    },
    "entries": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": [
          "path",
          "size",
          "sha256",
          "mode"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)\\\\.\\\\.?/)[^\\\\\\\\]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 134217728
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          }
        }
      }
    }
  }
}
