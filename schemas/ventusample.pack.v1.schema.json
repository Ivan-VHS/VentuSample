{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/VentuSample/blob/main/schemas/ventusample.pack.v1.schema.json",
  "title": "VentuSample Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generator",
    "audio_format",
    "parameters",
    "source_sample",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "ventusample.pack.v1"
    },
    "generator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "audio_format": {
      "const": "wav_pcm16_stereo"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "target",
        "bpm",
        "key",
        "scale",
        "bars",
        "variations",
        "swing_percent",
        "density_percent",
        "grit_percent",
        "saturation_percent",
        "stereo_percent",
        "high_pass_hz",
        "low_pass_hz",
        "snare_offset_ms",
        "bus_compression_ratio",
        "triplet_rolls",
        "micro_humanize",
        "vinyl_dust",
        "seed",
        "sample_rate",
        "sampler",
        "timbre",
        "source_mix_percent",
        "source_pitch_semitones"
      ],
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "Boom Bap",
            "East Coast",
            "Harlem Dip-Trap",
            "G-Unit",
            "Modern Trap",
            "Atlanta Trap",
            "UK Drill",
            "UK Grime",
            "Memphis",
            "Jazz Rap",
            "G-Funk",
            "Boom Trap",
            "Cripple Trill",
            "Billionaire Golden Era"
          ]
        },
        "target": {
          "type": "string",
          "enum": [
            "Full Loop",
            "Melody",
            "Drums",
            "Bass",
            "One-Shot Kit"
          ]
        },
        "bpm": {
          "type": "integer",
          "minimum": 60,
          "maximum": 190
        },
        "key": {
          "type": "string",
          "enum": [
            "C",
            "Csharp",
            "D",
            "Dsharp",
            "E",
            "F",
            "Fsharp",
            "G",
            "Gsharp",
            "A",
            "Asharp",
            "B"
          ]
        },
        "scale": {
          "type": "string",
          "enum": [
            "Natural Minor",
            "Harmonic Minor",
            "Dorian",
            "Phrygian",
            "Major",
            "Minor Pentatonic"
          ]
        },
        "bars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "variations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "swing_percent": {
          "type": "integer",
          "minimum": 50,
          "maximum": 68
        },
        "density_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "grit_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "saturation_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "stereo_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "high_pass_hz": {
          "type": "integer",
          "minimum": 20,
          "maximum": 300
        },
        "low_pass_hz": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 20000
        },
        "snare_offset_ms": {
          "type": "integer",
          "minimum": -30,
          "maximum": 30
        },
        "bus_compression_ratio": {
          "type": "number",
          "minimum": 1,
          "maximum": 12
        },
        "triplet_rolls": {
          "type": "boolean"
        },
        "micro_humanize": {
          "type": "boolean"
        },
        "vinyl_dust": {
          "type": "boolean"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "sample_rate": {
          "type": "integer",
          "enum": [
            22050,
            44100,
            48000,
            96000
          ]
        },
        "sampler": {
          "type": "string",
          "enum": [
            "Clean",
            "MPC 2500",
            "MPC 3000XL",
            "MPC 5000"
          ]
        },
        "timbre": {
          "type": "string",
          "enum": [
            "Keys",
            "Bell",
            "Pluck",
            "Organ",
            "Brass",
            "Strings"
          ]
        },
        "source_mix_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "source_pitch_semitones": {
          "type": "integer",
          "minimum": -12,
          "maximum": 12
        }
      }
    },
    "source_sample": {
      "type": "string",
      "maxLength": 255
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "peak",
          "rms",
          "crest_db",
          "variation"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "peak": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rms": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "crest_db": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "variation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          }
        }
      }
    }
  }
}
