{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/VentuSample/blob/main/schemas/ventusample.pack.v2.schema.json",
  "title": "VentuSample Pack v2 — tonal export metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generator",
    "audio_format",
    "parameters",
    "source_sample",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "ventusample.pack.v2"
    },
    "generator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "audio_format": {
      "const": "wav_pcm16_stereo"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "target",
        "bpm",
        "key",
        "scale",
        "bars",
        "variations",
        "swing_percent",
        "density_percent",
        "grit_percent",
        "saturation_percent",
        "stereo_percent",
        "high_pass_hz",
        "low_pass_hz",
        "snare_offset_ms",
        "bus_compression_ratio",
        "triplet_rolls",
        "micro_humanize",
        "vinyl_dust",
        "seed",
        "sample_rate",
        "sampler",
        "timbre",
        "source_mix_percent",
        "source_pitch_semitones",
        "musical_key",
        "mode_family"
      ],
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "Boom Bap",
            "East Coast",
            "Harlem Dip-Trap",
            "G-Unit",
            "Modern Trap",
            "Atlanta Trap",
            "UK Drill",
            "UK Grime",
            "Memphis",
            "Jazz Rap",
            "G-Funk",
            "Boom Trap",
            "Cripple Trill"
          ]
        },
        "target": {
          "type": "string",
          "enum": [
            "Full Loop",
            "Melody",
            "Drums",
            "Bass",
            "One-Shot Kit"
          ]
        },
        "bpm": {
          "type": "integer",
          "minimum": 60,
          "maximum": 190
        },
        "key": {
          "type": "string",
          "enum": [
            "C",
            "Csharp",
            "D",
            "Dsharp",
            "E",
            "F",
            "Fsharp",
            "G",
            "Gsharp",
            "A",
            "Asharp",
            "B"
          ]
        },
        "scale": {
          "type": "string",
          "enum": [
            "Natural Minor",
            "Harmonic Minor",
            "Dorian",
            "Phrygian",
            "Major",
            "Minor Pentatonic"
          ]
        },
        "bars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "variations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "swing_percent": {
          "type": "integer",
          "minimum": 50,
          "maximum": 68
        },
        "density_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "grit_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "saturation_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "stereo_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "high_pass_hz": {
          "type": "integer",
          "minimum": 20,
          "maximum": 300
        },
        "low_pass_hz": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 20000
        },
        "snare_offset_ms": {
          "type": "integer",
          "minimum": -30,
          "maximum": 30
        },
        "bus_compression_ratio": {
          "type": "number",
          "minimum": 1,
          "maximum": 12
        },
        "triplet_rolls": {
          "type": "boolean"
        },
        "micro_humanize": {
          "type": "boolean"
        },
        "vinyl_dust": {
          "type": "boolean"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "sample_rate": {
          "type": "integer",
          "enum": [
            22050,
            44100,
            48000,
            96000
          ]
        },
        "sampler": {
          "type": "string",
          "enum": [
            "Clean",
            "MPC 2500",
            "MPC 3000XL",
            "MPC 5000"
          ]
        },
        "timbre": {
          "type": "string",
          "enum": [
            "Keys",
            "Bell",
            "Pluck",
            "Organ",
            "Brass",
            "Strings"
          ]
        },
        "source_mix_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "source_pitch_semitones": {
          "type": "integer",
          "minimum": -12,
          "maximum": 12
        },
        "musical_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "mode_family": {
          "type": "string",
          "enum": [
            "major",
            "minor",
            "modal"
          ]
        },
        "stochastic_enabled": {
          "type": "boolean",
          "description": "Whether offline stochastic DSP processing was enabled."
        },
        "stochastic_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "stochastic_intensity_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "stochastic_trigger_mode": {
          "type": "string",
          "enum": [
            "file",
            "bar",
            "onset"
          ]
        },
        "stochastic_plugin_mask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "stochastic_topology": {
          "type": "string",
          "enum": [
            "hybrid",
            "serial",
            "parallel"
          ]
        },
        "tpdf_dither": {
          "type": "boolean",
          "description": "Whether deterministic TPDF noise was added during PCM16 quantization."
        },
        "normalize_peak": {
          "type": "boolean",
          "description": "Whether linear sample-peak normalization was requested."
        },
        "target_peak_dbfs": {
          "type": "number",
          "minimum": -24,
          "maximum": -0.3
        }
      }
    },
    "source_sample": {
      "type": "string",
      "maxLength": 255
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "peak",
          "rms",
          "crest_db",
          "variation",
          "musical_key",
          "scale",
          "mode_family"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "peak": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rms": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "crest_db": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "variation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "musical_key": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "scale": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Natural Minor",
              "Harmonic Minor",
              "Dorian",
              "Phrygian",
              "Major",
              "Minor Pentatonic",
              null
            ]
          },
          "mode_family": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "major",
              "minor",
              "modal",
              "pitched_note",
              null
            ]
          },
          "stochastic_routes": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "left_rms": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "right_rms": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "stereo_correlation": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "dither": {
            "type": "string",
            "enum": [
              "off",
              "tpdf"
            ]
          },
          "dither_seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "normalized": {
            "type": "boolean"
          },
          "normalization_skipped_silence": {
            "type": "boolean"
          }
        }
      }
    },
    "measurement_basis": {
      "type": "string",
      "enum": [
        "sample_domain"
      ],
      "description": "Metering values are based on stored PCM samples; no LUFS or oversampled true-peak claim is implied."
    }
  }
}
