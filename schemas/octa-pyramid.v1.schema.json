{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/VentuSample/blob/main/schemas/octa-pyramid.v1.schema.json",
  "title": "OCTA-8 Federation Pyramid v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "topology_id",
    "shape",
    "apex",
    "base_mesh",
    "facets",
    "peer_links",
    "self_loops",
    "semantics"
  ],
  "properties": {
    "schema": {
      "const": "octa.federation-pyramid.v1"
    },
    "topology_id": {
      "const": "octa-8"
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "base_sides",
        "triangular_facets",
        "apex_vertex"
      ],
      "properties": {
        "kind": {
          "const": "octagonal-pyramid"
        },
        "base_sides": {
          "const": 8
        },
        "triangular_facets": {
          "const": 8
        },
        "apex_vertex": {
          "const": "octa-hub"
        }
      }
    },
    "apex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "executable",
        "single_point_of_failure",
        "linked_facets"
      ],
      "properties": {
        "id": {
          "const": "octa-hub"
        },
        "role": {
          "const": "protocol-coordination-only"
        },
        "executable": {
          "const": false
        },
        "single_point_of_failure": {
          "const": false
        },
        "linked_facets": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^facet\\.[a-z]+$"
          }
        }
      }
    },
    "base_mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "project_ids",
        "directed_peer_links",
        "self_loops"
      ],
      "properties": {
        "mode": {
          "const": "horizontal-complete-directed-peer-mesh"
        },
        "project_ids": {
          "const": [
            "reaper",
            "pytyliki",
            "oplague",
            "ventusample"
          ]
        },
        "directed_peer_links": {
          "const": 12
        },
        "self_loops": {
          "const": 4
        }
      }
    },
    "facets": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "side",
          "name",
          "invariant"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^facet\\.[a-z]+$"
          },
          "side": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "name": {
            "type": "string"
          },
          "invariant": {
            "type": "string"
          }
        }
      }
    },
    "peer_links": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "transport",
          "interface",
          "flow",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "enum": [
              "reaper",
              "pytyliki",
              "oplague",
              "ventusample"
            ]
          },
          "to": {
            "enum": [
              "reaper",
              "pytyliki",
              "oplague",
              "ventusample"
            ]
          },
          "transport": {
            "enum": [
              "json-file",
              "native-ffi",
              "none"
            ]
          },
          "interface": {
            "type": "string",
            "minLength": 1
          },
          "flow": {
            "enum": [
              "artifact",
              "request",
              "response",
              "none"
            ]
          },
          "status": {
            "enum": [
              "implemented",
              "planned",
              "not_applicable"
            ]
          }
        }
      }
    },
    "self_loops": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project",
          "contract",
          "surface"
        ],
        "properties": {
          "project": {
            "enum": [
              "reaper",
              "pytyliki",
              "oplague",
              "ventusample"
            ]
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_pairwise_product",
        "directed_link_count_formula",
        "hub_is_not_a_runtime_gateway",
        "request_response_edges_are_synchronous",
        "no_implicit_native_loading",
        "no_driver_mutation_through_mesh",
        "reaper_pack_consumer_implemented"
      ],
      "properties": {
        "complete_pairwise_product": {
          "const": true
        },
        "directed_link_count_formula": {
          "const": "n*(n-1)"
        },
        "hub_is_not_a_runtime_gateway": {
          "const": true
        },
        "request_response_edges_are_synchronous": {
          "const": true
        },
        "no_implicit_native_loading": {
          "const": true
        },
        "no_driver_mutation_through_mesh": {
          "const": true
        },
        "reaper_pack_consumer_implemented": {
          "const": true
        }
      }
    }
  }
}
