{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/shared-contracts/wellbeing-reference.v1.schema.json",
  "title": "Mental Wellbeing Awareness Reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "transcript_coverage",
    "topics",
    "guardrails"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "title",
        "video_url",
        "published_at",
        "duration",
        "source_note"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "video_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://www\\.youtube\\.com/watch\\?v="
        },
        "published_at": {
          "type": "string",
          "format": "date"
        },
        "duration": {
          "type": "string",
          "pattern": "^PT[0-9]+H[0-9]+M[0-9]+S$"
        },
        "source_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transcript_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_seconds",
        "available_segments",
        "missing_middle"
      ],
      "properties": {
        "duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "available_segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_seconds",
              "end_seconds"
            ],
            "properties": {
              "start_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "end_seconds": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "missing_middle": {
          "type": "boolean"
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "evidence_status",
          "timestamps_seconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "enum": [
              "transcript_excerpt",
              "insufficient_transcript"
            ]
          },
          "timestamps_seconds": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          }
        }
      }
    },
    "guardrails": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
