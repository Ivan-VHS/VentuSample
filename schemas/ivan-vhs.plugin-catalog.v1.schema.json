{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivan-vhs.github.io/plugin-contract/ivan-vhs.plugin-catalog.v1.schema.json",
  "title": "Ivan-VHS Cross-Repository Plugin Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog_version", "api_version", "plugins", "policy"],
  "properties": {
    "schema": {"const": "ivan-vhs.plugin-catalog.v1"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "api_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date"},
    "plugins": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "domain", "description", "capabilities"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80},
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "domain": {"type": "string", "minLength": 1, "maxLength": 80},
          "description": {"type": "string", "minLength": 1, "maxLength": 1000},
          "capabilities": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}}
        }
      }
    },
    "policy": {"type": "object", "required": ["discovery", "external_code_loading", "automatic_network_access", "implicit_project_mutation"], "properties": {
      "discovery": {"const": "metadata-only"},
      "external_code_loading": {"const": false},
      "automatic_network_access": {"const": false},
      "implicit_project_mutation": {"const": false}
    }}
  }
}
